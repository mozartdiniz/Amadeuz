<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="AmzAuthView" parent="AdwBin">
    <property name="child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="valign">center</property>
        <property name="spacing">0</property>
        <child>
          <object class="AdwClamp">
            <property name="maximum-size">420</property>
            <property name="margin-start">24</property>
            <property name="margin-end">24</property>
            <property name="margin-top">48</property>
            <property name="margin-bottom">48</property>
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">24</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">8</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-edit-symbolic</property>
                        <property name="pixel-size">64</property>
                        <style>
                          <class name="icon-dropshadow"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Amadeuz Notes</property>
                        <style>
                          <class name="title-1"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkStack" id="auth_stack">
                    <property name="transition-type">crossfade</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">login</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <child>
                                  <object class="AdwEntryRow" id="login_email">
                                    <property name="title" translatable="yes">Email</property>
                                    <property name="input-purpose">email</property>
                                    <property name="input-hints">no-emoji|lowercase</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="login_password">
                                    <property name="title" translatable="yes">Password</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="login_button">
                                <property name="label" translatable="yes">Sign In</property>
                                <property name="halign">fill</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">center</property>
                                <property name="spacing">4</property>
                                <child>
                                  <object class="GtkButton" id="switch_to_register_button">
                                    <property name="label" translatable="yes">Create account</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">·</property>
                                    <style>
                                      <class name="dim-label"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="switch_to_recover_button">
                                    <property name="label" translatable="yes">Forgot your password?</property>
                                    <style>
                                      <class name="flat"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">register</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <child>
                                  <object class="AdwEntryRow" id="register_email">
                                    <property name="title" translatable="yes">Email</property>
                                    <property name="input-purpose">email</property>
                                    <property name="input-hints">no-emoji|lowercase</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="register_password">
                                    <property name="title" translatable="yes">Password</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="register_button">
                                <property name="label" translatable="yes">Create Account</property>
                                <property name="halign">fill</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="switch_to_login_from_register_button">
                                <property name="label" translatable="yes">Already have an account? Sign in</property>
                                <property name="halign">center</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">recover</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">12</property>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <child>
                                  <object class="AdwEntryRow" id="recover_email">
                                    <property name="title" translatable="yes">Email</property>
                                    <property name="input-purpose">email</property>
                                    <property name="input-hints">no-emoji|lowercase</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwEntryRow" id="recover_code">
                                    <property name="title" translatable="yes">Recovery Code</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwPasswordEntryRow" id="recover_password">
                                    <property name="title" translatable="yes">New Password</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="recover_button">
                                <property name="label" translatable="yes">Recover Account</property>
                                <property name="halign">fill</property>
                                <style>
                                  <class name="suggested-action"/>
                                  <class name="pill"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="switch_to_login_from_recover_button">
                                <property name="label" translatable="yes">Back to sign in</property>
                                <property name="halign">center</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="error_label">
                    <property name="visible">false</property>
                    <property name="wrap">true</property>
                    <property name="justify">center</property>
                    <style>
                      <class name="error"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="settings_button">
                    <property name="label" translatable="yes">Server settings…</property>
                    <property name="halign">center</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
