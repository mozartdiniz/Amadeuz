<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="AmzWindow" parent="AdwApplicationWindow">
    <property name="width-request">360</property>
    <property name="height-request">500</property>
    <property name="default-width">960</property>
    <property name="default-height">640</property>
    <property name="content">
      <object class="GtkStack" id="main_stack">
        <property name="transition-type">crossfade</property>
        <property name="transition-duration">200</property>

        <!-- Welcome page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">welcome</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-back-button">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwStatusPage">
                    <property name="vexpand">true</property>
                    <property name="icon-name">document-edit-symbolic</property>
                    <property name="title" translatable="yes">Amadeuz Notes</property>
                    <property name="description" translatable="yes">Your self-hosted, privacy-first notes.</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">400</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <child>
                              <object class="AdwPreferencesGroup">
                                <child>
                                  <object class="AdwActionRow" id="offline_row">
                                    <property name="title" translatable="yes">Use Offline</property>
                                    <property name="subtitle" translatable="yes">All features, notes saved on this machine only. No account needed.</property>
                                    <property name="activatable">true</property>
                                    <child type="suffix">
                                      <object class="GtkImage">
                                        <property name="icon-name">go-next-symbolic</property>
                                        <style>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow" id="connect_row">
                                    <property name="title" translatable="yes">Connect to Server</property>
                                    <property name="subtitle" translatable="yes">Sync notes across your devices using your own server.</property>
                                    <property name="activatable">true</property>
                                    <child type="suffix">
                                      <object class="GtkImage">
                                        <property name="icon-name">go-next-symbolic</property>
                                        <style>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkButton" id="quit_welcome_button">
                                <property name="label" translatable="yes">Quit</property>
                                <property name="halign">center</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>

        <!-- Auth page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">auth</property>
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <property name="show-back-button">false</property>
                    <child type="start">
                      <object class="GtkButton" id="auth_back_button">
                        <property name="icon-name">go-previous-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Back</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="AmzAuthView" id="auth_view"/>
                </property>
              </object>
            </property>
          </object>
        </child>

        <!-- Main page -->
        <child>
          <object class="GtkStackPage">
            <property name="name">main</property>
            <property name="child">
              <object class="AdwNavigationSplitView" id="outer_split">
                <property name="min-sidebar-width">180</property>
                <property name="max-sidebar-width">240</property>
                <property name="sidebar">
                  <object class="AdwNavigationPage">
                    <property name="title" translatable="yes">Folders</property>
                    <property name="tag">folders</property>
                    <property name="child">
                      <object class="AdwToolbarView">
                        <child type="top">
                          <object class="AdwHeaderBar">
                            <child type="start">
                              <object class="GtkButton" id="new_folder_button">
                                <property name="icon-name">list-add-symbolic</property>
                                <property name="tooltip-text" translatable="yes">New Folder</property>
                                <style>
                                  <class name="flat"/>
                                </style>
                              </object>
                            </child>
                            <property name="title-widget">
                              <object class="GtkLabel">
                                <property name="label" translatable="yes">Amadeuz Notes</property>
                                <style>
                                  <class name="heading"/>
                                </style>
                              </object>
                            </property>
                            <child type="end">
                              <object class="GtkMenuButton" id="menu_button">
                                <property name="icon-name">open-menu-symbolic</property>
                                <property name="tooltip-text" translatable="yes">Main Menu</property>
                                <property name="primary">true</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <property name="content">
                          <object class="GtkScrolledWindow">
                            <property name="vexpand">true</property>
                            <property name="hscrollbar-policy">never</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <child>
                                  <object class="GtkListBox" id="all_notes_list">
                                    <property name="selection-mode">single</property>
                                    <style>
                                      <class name="navigation-sidebar"/>
                                    </style>
                                    <child>
                                      <object class="GtkListBoxRow">
                                        <child>
                                          <object class="GtkBox">
                                            <property name="margin-start">12</property>
                                            <property name="margin-end">12</property>
                                            <property name="margin-top">8</property>
                                            <property name="margin-bottom">8</property>
                                            <property name="spacing">8</property>
                                            <child>
                                              <object class="GtkImage">
                                                <property name="icon-name">document-open-recent-symbolic</property>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel">
                                                <property name="label" translatable="yes">All Notes</property>
                                                <property name="hexpand">true</property>
                                                <property name="halign">start</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkRevealer" id="new_folder_revealer">
                                    <property name="reveal-child">false</property>
                                    <property name="transition-type">slide-down</property>
                                    <property name="transition-duration">150</property>
                                    <child>
                                      <object class="GtkEntry" id="new_folder_entry">
                                        <property name="placeholder-text" translatable="yes">New folder name…</property>
                                        <property name="margin-start">12</property>
                                        <property name="margin-end">12</property>
                                        <property name="margin-top">4</property>
                                        <property name="margin-bottom">4</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkSeparator"/>
                                </child>
                                <child>
                                  <object class="GtkListBox" id="folder_list">
                                    <property name="selection-mode">single</property>
                                    <style>
                                      <class name="navigation-sidebar"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </property>
                        <child type="bottom">
                          <object class="GtkListBox" id="wastebasket_list">
                            <property name="selection-mode">single</property>
                            <style>
                              <class name="navigation-sidebar"/>
                            </style>
                            <child>
                              <object class="GtkListBoxRow">
                                <child>
                                  <object class="GtkBox">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="margin-top">6</property>
                                    <property name="margin-bottom">6</property>
                                    <property name="spacing">8</property>
                                    <child>
                                      <object class="GtkImage">
                                        <property name="icon-name">user-trash-symbolic</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">Recently Deleted</property>
                                        <property name="hexpand">true</property>
                                        <property name="halign">start</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="content">
                  <object class="AdwNavigationPage">
                    <property name="title" translatable="yes">Notes</property>
                    <property name="tag">notes</property>
                    <property name="child">
                      <object class="AdwNavigationSplitView" id="inner_split">
                        <property name="min-sidebar-width">260</property>
                        <property name="max-sidebar-width">380</property>
                        <property name="sidebar">
                          <object class="AdwNavigationPage">
                            <property name="title" translatable="yes">Notes</property>
                            <property name="tag">note-list</property>
                            <property name="child">
                              <object class="AdwToolbarView">
                                <child type="top">
                                  <object class="AdwHeaderBar">
                                    <child type="start">
                                      <object class="GtkButton" id="new_note_button">
                                        <property name="icon-name">list-add-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">New Note</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <property name="content">
                                  <object class="GtkScrolledWindow">
                                    <property name="vexpand">true</property>
                                    <property name="hscrollbar-policy">never</property>
                                    <child>
                                      <object class="GtkListBox" id="note_list">
                                        <property name="selection-mode">single</property>
                                        <style>
                                          <class name="navigation-sidebar"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                        <property name="content">
                          <object class="AdwNavigationPage" id="editor_page">
                            <property name="title"></property>
                            <property name="tag">editor</property>
                            <property name="child">
                              <object class="AdwToolbarView" id="editor_toolbar">
                                <child type="top">
                                  <object class="AdwHeaderBar">
                                    <child type="start">
                                      <object class="GtkToggleButton" id="search_button">
                                        <property name="icon-name">system-search-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Search</property>
                                      </object>
                                    </child>
                                    <property name="title-widget">
                                      <object class="GtkStack" id="search_stack">
                                        <property name="transition-type">crossfade</property>
                                        <property name="transition-duration">150</property>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">empty</property>
                                            <property name="child">
                                              <object class="GtkLabel">
                                                <property name="label"></property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkStackPage">
                                            <property name="name">search</property>
                                            <property name="child">
                                              <object class="GtkSearchEntry" id="search_entry">
                                                <property name="placeholder-text" translatable="yes">Search notes…</property>
                                                <property name="hexpand">true</property>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                    <child type="end">
                                      <object class="GtkButton" id="delete_note_button">
                                        <property name="icon-name">user-trash-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Move to Trash</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <property name="content">
                                  <object class="GtkScrolledWindow">
                                    <property name="vexpand">true</property>
                                    <property name="hexpand">true</property>
                                    <child>
                                      <object class="GtkTextView" id="text_view">
                                        <property name="vexpand">true</property>
                                        <property name="hexpand">true</property>
                                        <property name="wrap-mode">word-char</property>
                                        <property name="top-margin">16</property>
                                        <property name="bottom-margin">16</property>
                                        <property name="left-margin">20</property>
                                        <property name="right-margin">20</property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                                <child type="bottom">
                                  <object class="GtkActionBar" id="status_bar">
                                    <child type="start">
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkImage" id="status_icon">
                                            <property name="icon-name">network-offline-symbolic</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="status_label">
                                            <property name="label" translatable="yes">Offline</property>
                                            <style>
                                              <class name="caption"/>
                                              <class name="dim-label"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
