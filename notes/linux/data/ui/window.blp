using Gtk 4.0;
using Adw 1;

template $AmzWindow : Adw.ApplicationWindow {
  width-request: 360;
  height-request: 500;
  default-width: 960;
  default-height: 640;

  // Root stack: auth view or main view.
  content: Gtk.Stack main_stack {
    transition-type: crossfade;
    transition-duration: 200;

    // ── Auth page ─────────────────────────────────────────────────────────
    Gtk.StackPage {
      name: "auth";
      child: $AmzAuthView auth_view {};
    }

    // ── Main page: 3-column layout ────────────────────────────────────────
    Gtk.StackPage {
      name: "main";
      child: Adw.NavigationSplitView outer_split {
      min-sidebar-width: 180;
      max-sidebar-width: 240;

      // Left column: folder list
      sidebar: Adw.NavigationPage {
        title: _("Folders");
        tag: "folders";

        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Gtk.Button new_folder_button {
              icon-name: "list-add-symbolic";
              tooltip-text: _("New Folder");
              styles ["flat"]
            }

            title-widget: Gtk.Label {
              label: _("Amadeuz Notes");
              styles ["heading"]
            };

            [end]
            Gtk.MenuButton menu_button {
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              primary: true;
              menu-model: main_menu;
            }
          }

          Gtk.ScrolledWindow {
            vexpand: true;
            hscrollbar-policy: never;

            Gtk.Box {
              orientation: vertical;

              // "All Notes" row pinned at top
              Gtk.ListBox all_notes_list {
                selection-mode: single;
                styles ["navigation-sidebar"]

                Gtk.ListBoxRow {
                  Gtk.Box {
                    margin-start: 12;
                    margin-end: 12;
                    margin-top: 8;
                    margin-bottom: 8;
                    spacing: 8;

                    Gtk.Image {
                      icon-name: "document-open-recent-symbolic";
                    }
                    Gtk.Label {
                      label: _("All Notes");
                      hexpand: true;
                      halign: start;
                    }
                  }
                }
              }

              Gtk.Revealer new_folder_revealer {
                reveal-child: false;
                transition-type: slide_down;
                transition-duration: 150;

                Gtk.Entry new_folder_entry {
                  placeholder-text: _("New folder name…");
                  margin-start: 12;
                  margin-end: 12;
                  margin-top: 4;
                  margin-bottom: 4;
                }
              }

              Gtk.Separator {}

              Gtk.ListBox folder_list {
                selection-mode: single;
                styles ["navigation-sidebar"]
              }
            }
          }

          [bottom]
          Gtk.ListBox wastebasket_list {
            selection-mode: single;
            styles ["navigation-sidebar"]

            Gtk.ListBoxRow {
              Gtk.Box {
                margin-start: 12;
                margin-end: 12;
                margin-top: 6;
                margin-bottom: 6;
                spacing: 8;

                Gtk.Image {
                  icon-name: "user-trash-symbolic";
                }
                Gtk.Label {
                  label: _("Recently Deleted");
                  hexpand: true;
                  halign: start;
                }
              }
            }
          }
        };
      };

      // Right side: note list + editor (inner split)
      content: Adw.NavigationPage {
        title: _("Notes");
        tag: "notes";

        child: Adw.NavigationSplitView inner_split {
          min-sidebar-width: 260;
          max-sidebar-width: 380;

          // Middle column: note list
          sidebar: Adw.NavigationPage {
            title: _("Notes");
            tag: "note-list";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                Gtk.Button new_note_button {
                  icon-name: "list-add-symbolic";
                  tooltip-text: _("New Note");
                }
              }

              Gtk.ScrolledWindow {
                vexpand: true;
                hscrollbar-policy: never;

                Gtk.ListBox note_list {
                  selection-mode: single;
                  styles ["navigation-sidebar"]
                }
              }
            };
          };

          // Right column: editor
          content: Adw.NavigationPage editor_page {
            title: "";
            tag: "editor";

            child: Adw.ToolbarView editor_toolbar {
              [top]
              Adw.HeaderBar {
                [start]
                Gtk.ToggleButton search_button {
                  icon-name: "system-search-symbolic";
                  tooltip-text: _("Search");
                }

                title-widget: Gtk.Stack search_stack {
                  transition-type: crossfade;
                  transition-duration: 150;

                  Gtk.StackPage {
                    name: "empty";
                    child: Gtk.Label { label: ""; };
                  }

                  Gtk.StackPage {
                    name: "search";
                    child: Gtk.SearchEntry search_entry {
                      placeholder-text: _("Search notes…");
                      hexpand: true;
                    };
                  }
                };

                [end]
                Gtk.Button delete_note_button {
                  icon-name: "user-trash-symbolic";
                  tooltip-text: _("Move to Trash");
                  styles ["flat"]
                }
              }

              Gtk.ScrolledWindow {
                vexpand: true;
                hexpand: true;

                Gtk.TextView text_view {
                  vexpand: true;
                  hexpand: true;
                  wrap-mode: word_char;
                  top-margin: 16;
                  bottom-margin: 16;
                  left-margin: 20;
                  right-margin: 20;
                }
              }

              [bottom]
              Gtk.ActionBar status_bar {
                [start]
                Gtk.Box {
                  spacing: 6;

                  Gtk.Image status_icon {
                    icon-name: "network-offline-symbolic";
                  }

                  Gtk.Label status_label {
                    label: _("Offline");
                    styles ["caption", "dim-label"]
                  }
                }
              }
            };
          };
        };
      };
    };
  }
  };
}

menu main_menu {
  section {
    item {
      label: _("_Server Settings");
      action: "win.show-preferences";
    }
    item {
      label: _("_Sign Out");
      action: "win.sign-out";
    }
  }
  section {
    item {
      label: _("_About Amadeuz Notes");
      action: "win.show-about";
    }
  }
}
