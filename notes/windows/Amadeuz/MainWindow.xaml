<Window
    x:Class="Amadeuz.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Amadeuz Notes">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Note editing area.
            Background="Transparent" lets Mica show through.
            FontFamily="Segoe UI Variable Text" is the native Win11 reading font.
        -->
        <TextBox x:Name="NoteTextBox"
                 Grid.Row="0"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="15"
                 FontFamily="Segoe UI Variable Text"
                 Padding="28,20,28,20"
                 BorderThickness="0"
                 Background="Transparent"
                 VerticalAlignment="Stretch"
                 TextChanged="NoteTextBox_TextChanged"/>

        <!-- Status bar — subtle layer tint so it reads as a separate surface -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection indicator dot -->
                <Ellipse x:Name="StatusDot"
                         Grid.Column="0"
                         Width="8" Height="8"
                         Margin="0,0,8,0"
                         Fill="#EF4444"
                         VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Offline"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="3"
                        Content="Settings"
                        FontSize="12"
                        Padding="12,5"
                        CornerRadius="6"
                        Click="SettingsButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
