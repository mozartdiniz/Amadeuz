<Window
    x:Class="Amadeuz.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Amadeuz"
    Title="Amadeuz Notes">

    <!--
        Three-column layout mirroring Apple Notes / the macOS SwiftUI implementation:
          Col 0 (220 px)  — folder sidebar
          Col 1 (1 px)    — vertical separator
          Col 2 (260 px)  — note list
          Col 3 (1 px)    — vertical separator
          Col 4 (*)       — note editor
    -->
    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="160"/>
            <ColumnDefinition x:Name="SidebarSeparatorColumn" Width="1"/>
            <ColumnDefinition Width="260" MinWidth="180"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"   MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- ── Col 0: Folder sidebar ──────────────────────────────────────── -->
        <Grid Grid.Column="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>     <!-- folder list (includes All Notes) -->
                <RowDefinition Height="Auto"/>  <!-- New Folder button -->
            </Grid.RowDefinitions>

            <!--
                Single ListView for "All Notes" + real folders.
                The VM's FolderItems collection always has the AllNotes sentinel first.
            -->
            <ListView x:Name="FolderListView"
                      Grid.Row="0"
                      ItemsSource="{x:Bind Vm.FolderItems}"
                      SelectionChanged="FolderListView_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding"                     Value="4,0"/>
                        <Setter Property="HorizontalContentAlignment"  Value="Stretch"/>
                        <Setter Property="MinHeight"                   Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FolderItem">
                        <Grid Padding="12,9"
                              RightTapped="FolderItem_RightTapped">
                            <TextBlock Text="{x:Bind Name}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- New Folder button — pinned to the bottom of the sidebar -->
            <Button x:Name="NewFolderButton"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="14,10"
                    FontSize="12"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    Click="NewFolderButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE8F4;"
                              FontSize="12"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="New Folder" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ── Separator 1 ───────────────────────────────────────────────── -->
        <Border Grid.Column="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- ── Col 2: Note list ──────────────────────────────────────────── -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- toolbar row -->
                <RowDefinition Height="*"/>     <!-- note list -->
            </Grid.RowDefinitions>

            <!-- Toolbar: sidebar toggle + folder title + action buttons -->
            <Border Grid.Row="0"
                    Padding="6,0,14,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    MinHeight="44">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>  <!-- sidebar toggle -->
                        <ColumnDefinition Width="*"/>     <!-- folder title -->
                        <ColumnDefinition Width="Auto"/>  <!-- action buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar toggle button -->
                    <Button x:Name="SidebarToggleButton"
                            Grid.Column="0"
                            Padding="7"
                            Margin="0,0,4,0"
                            CornerRadius="4"
                            Background="Transparent"
                            ToolTipService.ToolTip="Toggle Sidebar"
                            Click="SidebarToggleButton_Click">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE700;"
                                  FontSize="13"/>
                    </Button>

                    <TextBlock x:Name="NoteListTitle"
                               Grid.Column="1"
                               Text="All Notes"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <!-- Delete note -->
                        <Button x:Name="DeleteNoteButton"
                                IsEnabled="False"
                                Padding="7"
                                CornerRadius="4"
                                Background="Transparent"
                                ToolTipService.ToolTip="Delete Note"
                                Click="DeleteNoteButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE74D;"
                                      FontSize="12"/>
                        </Button>
                        <!-- New note -->
                        <Button x:Name="NewNoteButton"
                                IsEnabled="False"
                                Padding="7"
                                CornerRadius="4"
                                Background="Transparent"
                                ToolTipService.ToolTip="New Note"
                                Click="NewNoteButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE70F;"
                                      FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Note ListView -->
            <ListView x:Name="NoteListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind Vm.FilteredNotes}"
                      SelectionChanged="NoteListView_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding"                    Value="4,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="MinHeight"                  Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:Note">
                        <Grid Padding="12,10"
                              RightTapped="NoteItem_RightTapped">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Title row + date -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="{x:Bind DisplayTitle, Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,64,0"/>
                                <TextBlock Text="{x:Bind FormattedDate, Mode=OneWay}"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Opacity="0.55"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <!-- Content preview -->
                            <TextBlock Grid.Row="1"
                                       Text="{x:Bind ContentPreview, Mode=OneWay}"
                                       FontSize="12"
                                       Opacity="0.6"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- ── Separator 2 ───────────────────────────────────────────────── -->
        <Border Grid.Column="3"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- ── Col 4: Note editor ────────────────────────────────────────── -->
        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- title -->
                <RowDefinition Height="1"/>     <!-- thin divider -->
                <RowDefinition Height="*"/>     <!-- content -->
                <RowDefinition Height="Auto"/>  <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- Note title -->
            <TextBox x:Name="TitleTextBox"
                     Grid.Row="0"
                     PlaceholderText="Title"
                     IsEnabled="False"
                     FontSize="20"
                     FontWeight="SemiBold"
                     FontFamily="Segoe UI Variable Display"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="24,20,24,12"
                     TextChanged="TitleTextBox_TextChanged"/>

            <!-- Title / content divider -->
            <Border Grid.Row="1"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!-- Note content -->
            <TextBox x:Name="ContentTextBox"
                     Grid.Row="2"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     IsEnabled="False"
                     FontSize="14"
                     FontFamily="Segoe UI Variable Text"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="24,16,24,16"
                     VerticalAlignment="Stretch"
                     TextChanged="ContentTextBox_TextChanged"/>

            <!-- Status bar -->
            <Border Grid.Row="3"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid Margin="16,8">
                    <!-- Left: connection indicator -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot"
                                 Width="8" Height="8"
                                 Fill="#EF4444"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText"
                                   Text="Offline"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Settings button -->
                    <Button Content="Settings"
                            FontSize="12"
                            Padding="12,5"
                            CornerRadius="6"
                            HorizontalAlignment="Right"
                            Click="SettingsButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
