<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Use net10.0-windows10.0.19041.0 if you have .NET 10 installed -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Amadeuz</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Force bootstrap initialization even in self-contained mode.
         Without this, MddBootstrapAutoInitializer never runs for self-contained builds,
         so the Windows App Runtime is never activated before XAML tries to use it. -->
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Package.appxmanifest"/>
  </ItemGroup>

  <!-- Copy PRI resource files to publish output (required for unpackaged WinUI 3) -->
  <Target Name="CopyPriFilesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <PriFiles Include="$(TargetDir)*.pri" />
    </ItemGroup>
    <Copy SourceFiles="@(PriFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

</Project>
